# API Backend URL (Fly.io)
VITE_API_URL=https://educa-backend.fly.dev

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Entrar con Google / Microsoft / Apple (opcional). Sólo los que estén activos
# en el panel de Supabase (Authentication → Providers). "azure" es Microsoft.
VITE_AUTH_PROVIDERS=google,azure

