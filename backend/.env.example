# development | production. With ENVIRONMENT=production the API refuses to start
# while JWT_SECRET is still the placeholder below.
ENVIRONMENT=development

# Database
# Local development: postgresql+psycopg://educa:educa@localhost:5432/educa
# Production (Supabase pooler): postgresql+psycopg://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql+psycopg://educa:educa@localhost:5432/educa

# JWT
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for encrypting provider credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Shared secret used to verify inbound provider webhooks (Zoom signature /
# Google channel token). Leave empty and /webhooks/* rejects everything.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# The academy's wall-clock. Class times are stored without a zone because a
# timetable is planned in local time, so this is how they are read back —
# notably for the lobby's "15 minutes before class" window. Must be an IANA
# name; it is NOT the server's timezone.
ACADEMY_TIMEZONE=America/Guatemala

# Supabase Auth (opcional). Sin estos valores, /auth/supabase-login responde 503
# y sólo funciona el login propio de Educa. El token que manda el navegador se
# valida contra Supabase, así que la clave anon basta; NO uses la service_role.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# CORS (comma-separated origins)
# Add your Vercel frontend URL in production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Patrón adicional de orígenes permitidos, para las vistas previas del propio
# proyecto. Déjalo vacío salvo que lo necesites: un comodín como
# `https://.*\.vercel\.app` deja entrar a cualquiera que publique en Vercel.
# Ejemplo: CORS_ORIGIN_REGEX=https://educa-[a-z0-9-]+\.vercel\.app
CORS_ORIGIN_REGEX=

# Correo saliente (SMTP). Vacío = los avisos se quedan sólo en la campana.
# Vale cualquier proveedor SMTP (Resend, Brevo, SendGrid, Google Workspace…).
# Puerto 465 = SSL directo; cualquier otro = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=notificaciones@tu-dominio.com

# WhatsApp Cloud API (Meta). Vacío = no se envía por WhatsApp.
# Las plantillas que hay que tener aprobadas están en DEPLOYMENT.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=es
# Prefijo para teléfonos guardados sin código de país (502 = Guatemala).
WHATSAPP_DEFAULT_COUNTRY_CODE=502

# Avisos push del navegador (Web Push). Vacío = sin avisos push.
# Genéralas UNA vez con: python -m app.cli generate-vapid-keys
# Cambiarlas después obliga a cada dispositivo a volver a activar los avisos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tu-dominio.com

# Enlace a la aplicación al pie de los correos (opcional).
APP_URL=

# Cada cuántos segundos corren las tareas de fondo de la API (enviar la cola de
# avisos y, cuando toca, el barrido de riesgo). 0 = desactivadas.
BACKGROUND_JOBS_INTERVAL_SECONDS=20

# Barrido semanal de alumnos en riesgo: día (0 = lunes) y hora de la academia.
AT_RISK_SWEEP_ENABLED=true
AT_RISK_SWEEP_WEEKDAY=0
AT_RISK_SWEEP_HOUR=7

# Seed admin (used by app/seed.py)
SEED_ADMIN_EMAIL=admin@educa.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Administrador